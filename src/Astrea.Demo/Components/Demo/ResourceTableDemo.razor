@using Astrea.Components.ResourceTable
@using Microsoft.AspNetCore.Components.Web

<div class="demo-controls" role="group" aria-label="ResourceTable 列宽控制">
    <label class="demo-check">
        <input id="toggle-rt-resizable" type="checkbox" checked="@_rtResizableColumns" @onchange="ToggleRtResizable" />
        列宽拖拽
    </label>
    <span class="demo-hint">指针拖动列边界，或聚焦手柄后按 ←/→ 调整（每次 10px）。</span>
</div>

<div class="demo-table-box">
    <ResourceTable Columns="_rtColumns"
                   TableBody="@RenderRows"
                   ResizableColumns="_rtResizableColumns"
                   aria-label="资源表"
                   data-testid="demo-resource-table"
                   ShowRedoButton="true"
                   CanUndo="_rtUndoStack.Count > 0"
                   CanRedo="_rtRedoStack.Count > 0"
                   OnAddClicked="AddRow"
                   OnRemoveClicked="RemoveRow"
                   OnMoveUpClicked="MoveUp"
                   OnMoveDownClicked="MoveDown"
                   OnUndoClicked="Undo"
                   OnRedoClicked="Redo"
                   OnColumnResized="HandleColumnResized"
                   OnKeyDown="HandleRtKeyDown">
    </ResourceTable>
</div>

<p class="demo-hint">
    工具栏依次为 Add / Remove / Move Up / Move Down / Undo / Redo；焦点在表格容器时可用 ↑/↓ 移动选中行。
    列宽调整保持相邻两列总宽不变，并遵守各列 MinWidth。
</p>

@code {
    [CascadingParameter]
    private DemoEventLogStore LogStore { get; set; } = default!;

    private readonly List<TableColumn> _rtColumns = new()
    {
        new("ID") { Key = "id", Width = "60px", MinWidth = 40 },
        new("名称") { Key = "name", Width = "160px", MinWidth = 60 },
        new("类型") { Key = "type", Width = "100px" },
        new("备注") { Key = "note" },
    };

    private readonly List<ResourceRow> _rtRows = new()
    {
        new(1, "颜色表", "ColorTable", "资源颜色定义"),
        new(2, "字体表", "FontTable", "资源字体定义"),
        new(3, "图片表", "PictureTable", "资源图片定义"),
    };

    private readonly Stack<ResourceSnapshot> _rtUndoStack = new();
    private readonly Stack<ResourceSnapshot> _rtRedoStack = new();

    private int? _rtSelectedIndex;
    private int _rtNextId = 4;
    private bool _rtResizableColumns = true;

    private string SelectedRowLabel => _rtSelectedIndex is int index && index < _rtRows.Count
        ? $"{_rtRows[index].Name}（第 {index + 1} 行）"
        : "无";

    public ResourceTableDemoStatus Status => new(
        _rtRows.Count,
        SelectedRowLabel,
        _rtUndoStack.Count,
        _rtRedoStack.Count,
        _rtResizableColumns);

    private sealed record ResourceRow(int Id, string Name, string Type, string Note);

    private sealed record ResourceSnapshot(List<ResourceRow> Rows, int? SelectedIndex);

    private RenderFragment RenderRows => builder =>
    {
        for (var i = 0; i < _rtRows.Count; i++)
        {
            var row = _rtRows[i];
            var index = i;

            builder.OpenElement(0, "tr");
            if (index == _rtSelectedIndex)
            {
                builder.AddAttribute(1, "class", "ast-rt-row-selected");
            }

            builder.AddAttribute(2, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => SelectRow(index)));

            builder.OpenElement(3, "td");
            builder.AddContent(4, row.Id);
            builder.CloseElement();
            builder.OpenElement(5, "td");
            builder.AddContent(6, row.Name);
            builder.CloseElement();
            builder.OpenElement(7, "td");
            builder.AddContent(8, row.Type);
            builder.CloseElement();
            builder.OpenElement(9, "td");
            builder.AddContent(10, row.Note);
            builder.CloseElement();
            builder.CloseElement();
        }
    };

    private void SelectRow(int index)
    {
        _rtSelectedIndex = index;
        Log($"选中：{_rtRows[index].Name}");
    }

    private void AddRow()
    {
        Snapshot();
        var id = _rtNextId++;
        var row = new ResourceRow(id, $"资源 {id}", "NewTable", "新建资源");
        _rtRows.Add(row);
        _rtSelectedIndex = _rtRows.Count - 1;
        Log($"添加：{row.Name}（已选中）");
    }

    private void RemoveRow()
    {
        if (_rtSelectedIndex is not int index || index >= _rtRows.Count)
        {
            Log("未选中行，无法删除");
            return;
        }

        Snapshot();
        var removed = _rtRows[index];
        _rtRows.RemoveAt(index);
        _rtSelectedIndex = _rtRows.Count == 0 ? null : Math.Min(index, _rtRows.Count - 1);
        Log($"删除：{removed.Name}");
    }

    private void MoveUp()
    {
        if (_rtSelectedIndex is not int index || index <= 0)
        {
            Log("无法上移（未选中或已在顶部）");
            return;
        }

        Snapshot();
        (_rtRows[index - 1], _rtRows[index]) = (_rtRows[index], _rtRows[index - 1]);
        _rtSelectedIndex = index - 1;
        Log($"上移：{_rtRows[index - 1].Name}");
    }

    private void MoveDown()
    {
        if (_rtSelectedIndex is not int index || index >= _rtRows.Count - 1)
        {
            Log("无法下移（未选中或已在底部）");
            return;
        }

        Snapshot();
        (_rtRows[index], _rtRows[index + 1]) = (_rtRows[index + 1], _rtRows[index]);
        _rtSelectedIndex = index + 1;
        Log($"下移：{_rtRows[index + 1].Name}");
    }

    private void Undo()
    {
        if (_rtUndoStack.Count == 0)
        {
            Log("无可撤销");
            return;
        }

        _rtRedoStack.Push(new ResourceSnapshot(_rtRows.ToList(), _rtSelectedIndex));
        Restore(_rtUndoStack.Pop());
        Log("撤销");
    }

    private void Redo()
    {
        if (_rtRedoStack.Count == 0)
        {
            Log("无可重做");
            return;
        }

        _rtUndoStack.Push(new ResourceSnapshot(_rtRows.ToList(), _rtSelectedIndex));
        Restore(_rtRedoStack.Pop());
        Log("重做");
    }

    private void Snapshot()
    {
        _rtUndoStack.Push(new ResourceSnapshot(_rtRows.ToList(), _rtSelectedIndex));
        _rtRedoStack.Clear();
    }

    private void Restore(ResourceSnapshot snapshot)
    {
        _rtRows.Clear();
        _rtRows.AddRange(snapshot.Rows);
        _rtSelectedIndex = snapshot.SelectedIndex;
    }

    private void ToggleRtResizable(ChangeEventArgs args)
    {
        _rtResizableColumns = (bool)(args.Value ?? false);
        Log(_rtResizableColumns ? "已开启列宽拖拽" : "已关闭列宽拖拽");
    }

    private void HandleColumnResized(ColumnResizedEventArgs args)
        => Log($"列宽调整：列 {args.ColumnIndex}（{args.ColumnKey ?? "-"}）→ {args.NewWidth:F0}px");

    private void HandleRtKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowUp")
        {
            MoveUp();
        }
        else if (args.Key == "ArrowDown")
        {
            MoveDown();
        }
        else
        {
            Log($"键盘：{args.Key}");
        }
    }

    private void Log(string message) => LogStore.Add(message);
}
