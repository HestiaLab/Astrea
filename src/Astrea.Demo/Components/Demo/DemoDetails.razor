<details class="demo-details @Class">
    <summary>@Summary</summary>
    <div class="demo-details__body">
        @ChildContent
    </div>
</details>

@code {
    [Parameter]
    public string Summary { get; set; } = "详情";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
