@using Astrea.Components.Tree
@implements IAsyncDisposable

<div class="demo-inspector">
    <div class="demo-inspector__header">
        <h4>状态检查器</h4>
        <span class="demo-inspector__hint">每 300 ms 读取 Tree.View</span>
    </div>
    <dl class="demo-kv">
        <div>
            <dt>选择模式</dt>
            <dd>@_snapshot.Mode</dd>
        </div>
        <div>
            <dt>选择所有权</dt>
            <dd>@(ControlledSelection ? "受控 SelectedIds" : "非受控")</dd>
        </div>
        <div>
            <dt>展开所有权</dt>
            <dd>@(ControlledExpansion ? "受控 ExpandedIds" : "非受控")</dd>
        </div>
        <div>
            <dt>Revision</dt>
            <dd>@_snapshot.Revision</dd>
        </div>
        <div>
            <dt>可见 / 总计</dt>
            <dd>@_snapshot.Visible / @_snapshot.Total</dd>
        </div>
        <div>
            <dt>焦点</dt>
            <dd>@(_snapshot.FocusedId ?? "—")</dd>
        </div>
    </dl>
    <p class="demo-selected"><span>选中</span> @_snapshot.Selected</p>
    @if (!string.IsNullOrWhiteSpace(Caption))
    {
        <p class="demo-hint">@Caption</p>
    }
</div>

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private Snapshot _snapshot = Snapshot.Empty;
    private Task? _pollTask;

    [Parameter]
    public Func<Tree?>? TreeAccessor { get; set; }

    [Parameter]
    public string ModeLabel { get; set; } = "—";

    [Parameter]
    public Func<string>? ModeAccessor { get; set; }

    [Parameter]
    public bool ControlledSelection { get; set; }

    [Parameter]
    public bool ControlledExpansion { get; set; }

    [Parameter]
    public string? Caption { get; set; }

    protected override void OnInitialized()
    {
        _snapshot = Read();
        _pollTask = PollAsync(_cancellation.Token);
    }

    protected override void OnParametersSet() => _snapshot = Read();

    private Snapshot Read()
    {
        var view = TreeAccessor?.Invoke()?.View;
        if (view is null)
        {
            return Snapshot.Empty;
        }

        var selected = view.GetSelectedNodes().Select(node => node.Text).ToArray();
        var summary = selected.Length == 0
            ? "（无）"
            : $"{string.Join("、", selected)}（{selected.Length}）";
        return new Snapshot(
            ModeAccessor?.Invoke() ?? ModeLabel,
            summary,
            view.FocusedId,
            view.Revision,
            view.FlattenVisible().Count,
            view.Flatten().Count);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(300));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var next = Read();
                if (next == _snapshot)
                {
                    continue;
                }

                _snapshot = next;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cancellation.Cancel();
        if (_pollTask is not null)
        {
            try
            {
                await _pollTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _cancellation.Dispose();
    }

    private readonly record struct Snapshot(
        string Mode,
        string Selected,
        string? FocusedId,
        long Revision,
        int Visible,
        int Total)
    {
        public static readonly Snapshot Empty = new("—", "（无）", null, 0, 0, 0);
    }
}
