<div class="demo-component-nav">
    <NavLink class="demo-component-nav__home" href="" Match="NavLinkMatch.All" ActiveClass="is-active">全部组件</NavLink>
    @foreach (var group in DemoComponentCatalog.ActiveByCategory)
    {
        <p class="demo-component-nav__category">@group.Key</p>
        <ul class="demo-component-nav__list">
            @foreach (var component in group)
            {
                <li>
                    <NavLink class="demo-component-nav__link" href="@component.Route" ActiveClass="is-active">@component.Title</NavLink>
                </li>
            }
        </ul>
    }
</div>
