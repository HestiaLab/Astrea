@page "/"
@using Astrea.Demo.Components.Demo

<PageTitle>Astrea 组件目录</PageTitle>

<main id="main-content" class="demo-catalog" data-testid="component-catalog">
    <header class="demo-catalog-hero">
        <p class="demo-eyebrow">Astrea · Blazor UI 组件库 · v0.9.0</p>
        <h1 data-demo-page-heading tabindex="-1">组件目录</h1>
        <p class="demo-catalog-hero__lede">
            当前版本只交付 Tree 与 ResourceTable。选择一个组件进入独立演示页；
            其他组件标记为 Deferred，不属于当前交付范围。
        </p>
        <div class="demo-tag-row" aria-label="技术特性">
            <span class="demo-tag">v0.9.0</span>
            <span class="demo-tag">net10.0</span>
            <span class="demo-tag">Blazor WebAssembly</span>
            <span class="demo-tag">Blazor Web App</span>
            <span class="demo-tag">WAI-ARIA</span>
            <span class="demo-tag">零运行时依赖</span>
        </div>
    </header>

    @foreach (var group in DemoComponentCatalog.ActiveByCategory)
    {
        <section class="demo-catalog-group" aria-label="@group.Key">
            <h2>@group.Key</h2>
            <div class="demo-catalog-grid">
                @foreach (var component in group)
                {
                    <NavLink class="demo-catalog-card" href="@component.Route">
                        <div class="demo-catalog-card__top">
                            <span class="demo-catalog-card__glyph" aria-hidden="true">@component.Title.Substring(0, 1)</span>
                            <span class="demo-tag demo-tag--active">Active</span>
                        </div>
                        <h3>@component.Title</h3>
                        <p>@component.Summary</p>
                        <ul class="demo-catalog-card__capabilities" aria-label="能力">
                            @foreach (var capability in component.Capabilities)
                            {
                                <li>@capability</li>
                            }
                        </ul>
                        <span class="demo-catalog-card__link">打开演示 <span aria-hidden="true">→</span></span>
                    </NavLink>
                }
            </div>
        </section>
    }

    <details class="demo-deferred">
        <summary>Deferred 组件与 Roadmap（@DemoComponentCatalog.Deferred.Count）</summary>
        <div class="demo-deferred__body">
            @foreach (var group in DemoComponentCatalog.DeferredByCategory)
            {
                <div class="demo-deferred__group">
                    <h3>@group.Key</h3>
                    <ul>
                        @foreach (var component in group)
                        {
                            <li>@component.Title</li>
                        }
                    </ul>
                </div>
            }
            <p class="demo-hint">
                Deferred 组件没有 Demo 页面，也不属于 v0.9.0 的交付契约。
                <a href="https://github.com/HestiaLab/Astrea/blob/main/docs/Roadmap.md" target="_blank" rel="noopener noreferrer">查看 Roadmap ↗</a>
            </p>
        </div>
    </details>

    <section class="demo-catalog-docs" aria-labelledby="catalog-docs-title">
        <h2 id="catalog-docs-title">文档</h2>
        <ul>
            <li><a href="https://github.com/HestiaLab/Astrea/blob/main/README.md" target="_blank" rel="noopener noreferrer">README ↗</a></li>
            <li><a href="https://github.com/HestiaLab/Astrea/blob/main/docs/SRS.md" target="_blank" rel="noopener noreferrer">SRS v0.9.0 ↗</a></li>
            <li><a href="https://github.com/HestiaLab/Astrea/blob/main/docs/requirements-test-matrix.md" target="_blank" rel="noopener noreferrer">需求-测试矩阵 ↗</a></li>
            <li><a href="https://github.com/HestiaLab/Astrea/blob/main/docs/release-evidence.md" target="_blank" rel="noopener noreferrer">发布验证证据 ↗</a></li>
            <li><a href="https://github.com/HestiaLab/Astrea/blob/main/docs/Roadmap.md" target="_blank" rel="noopener noreferrer">Roadmap ↗</a></li>
        </ul>
    </section>
</main>
